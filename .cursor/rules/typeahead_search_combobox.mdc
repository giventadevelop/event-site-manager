## DO

```tsx
<button
  type="button"
  onMouseDown={(e) => e.preventDefault()} // critical — blur vs click race
  onClick={() => applySelection(item)}
  role="option"
  aria-selected={selected}
>
  {item.label}
</button>
```

```tsx
const [inputValue, setInputValue] = useState(valueFromUrl);
const [open, setOpen] = useState(false);
// filter suggestions from inputValue; open on focus / change
// commit URL only on select / Enter / clear — never while typing partial queries
```

```typescript
// ✅ Local multi-field filter (mirror server fields)
function filterLocally(items, query) {
  const q = query.trim().toLowerCase();
  if (!q) return items;
  return items.filter((item) =>
    [item.organizationName, item.tenantId, item.domain]
      .some((v) => (v ?? '').toLowerCase().includes(q)),
  );
}
```

## DON'T

```tsx
// ❌ DON'T: sync URL / refetch on every keystroke (partial queries like "fa" cause loops)
onChange={(e) => {
  setInputValue(e.target.value);
  scheduleCommit(e.target.value); // WRONG for typeahead
}}

// ❌ DON'T: name-only server search when users also type IDs / codes
fetchTenantOrganizations(page, { search: trimmed }); // organizationName.contains only

// ❌ DON'T: resolve effect that depends on suggestion cache and falls back to results[0]
useEffect(() => {
  if (!cachedOrgs.some((o) => o.tenantId === tenantFromUrl)) {
    search(tenantFromUrl).then((results) => setCachedOrgs([results[0], ...])); // infinite loop
  }
}, [tenantFromUrl, cachedOrgs]);

// ❌ DON'T: replace dropdown with empty server results and wipe local ID matches
setDisplayOrgs(serverResults); // if empty, user loses cached tenantId hits

// ❌ DON'T: option click without mousedown preventDefault
<li onClick={() => select(item)}>{item.label}</li>

// ❌ DON'T: uncontrolled input bound only to searchParams
<input value={searchParams.get('tenant') ?? ''} onChange={...} />
```

